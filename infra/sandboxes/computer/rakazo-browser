#!/bin/sh
set -eu
RAKAZO_HOME="${HOME:-/home/rakazo}"
PROFILE="$RAKAZO_HOME/.browser-profiles/chromium"
mkdir -p "$PROFILE"
# Prefer real Chrome; fall back to chromium so the image still works without
# it. Set RAKAZO_BROWSER_BIN to pin a specific build, for example
# google-chrome-unstable for the Dev channel.
BIN="${RAKAZO_BROWSER_BIN:-}"
if [ -n "$BIN" ]; then
  BIN="$(command -v "$BIN" || echo "$BIN")"
else
  BIN="$(command -v google-chrome-stable \
    || command -v google-chrome \
    || command -v chromium \
    || command -v chromium-browser \
    || true)"
fi
if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
  echo "no google-chrome or chromium binary found" >&2
  exit 1
fi
exec "$BIN" \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-software-rasterizer \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --user-data-dir="$PROFILE" \
  --start-maximized \
  "$@"
