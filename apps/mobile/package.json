{
  "name": "@sentrabot/mobile",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit -p tsconfig.json",
    "expo:check": "expo install --check",
    "test": "vitest run --root ../.. apps/mobile/lib",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "prestart": "lingui compile",
    "preandroid": "lingui compile",
    "preios": "lingui compile",
    "intl:extract": "lingui extract --clean",
    "intl:compile": "lingui compile"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@react-native-vector-icons/ionicons": "13.1.4",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "@sentrabot/chat-ui": "workspace:*",
    "@sentrabot/contracts": "workspace:*",
    "@sentrabot/core": "workspace:*",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@lingui/cli": "6.9.0",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~57.0.14",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
