{
  "name": "@sentrabot/mobile",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit -p tsconfig.json",
    "expo:check": "expo install --check",
    "test": "vitest run --root ../.. apps/mobile/lib",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "prestart": "lingui compile",
    "preandroid": "lingui compile",
    "preios": "lingui compile",
    "intl:extract": "lingui extract --clean",
    "intl:compile": "lingui compile"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-native-vector-icons/material-design-icons": "14.0.0",
    "@sentrabot/chat-ui": "workspace:*",
    "@sentrabot/contracts": "workspace:*",
    "@sentrabot/core": "workspace:*",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-modules-core": "~58.0.30",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@react-native/metro-config": "0.88.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~58.0.24",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
