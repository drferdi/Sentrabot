      "sizes": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    },
    {
      "src": "/assets/favicon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ]
}
